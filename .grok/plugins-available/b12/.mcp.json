{
  "mcpServers": {
    "B12": {
      "command": "python3",
      "args": [
        "__SCRIPT_PATH__"
      ],
      "env": {
        "B12_DATA_DIR": "__B12_DATA_DIR__",
        "MCP_EMBEDDING_MODEL": "BAAI/bge-m3",
        "MCP_MAX_RESPONSE_CHARS": "40000"
      },
      "enabled": true,
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 180,
      "tool_timeouts": {
        "memory_consolidate": 300,
        "memory_refine": 120,
        "memory_quality": 120
      },
      "description": "B12 Persistent Memory System - Full MCP interface (search, store, consolidate, Ebbinghaus, quality, dashboard, etc.)"
    }
  }
}