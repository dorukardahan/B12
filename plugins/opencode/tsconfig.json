{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["bun-types"],
    "paths": {
      "@opencode-ai/plugin": ["~/.cache/opencode/node_modules/@opencode-ai/plugin"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
