memory-logs/
memory-summaries/

# ONNX model cache
onnx_models/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Node.js (semantic-release)
node_modules/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Environment files (may contain secrets)
.env
.env.*
!.env.example

