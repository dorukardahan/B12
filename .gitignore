*.key
*.pem
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.crt
credentials.json
service-account*.json

# Backup files
backups/
consolidation_archive/

# Personal/local files
*.local.md
working-memory.json
feedback.jsonl

# Training checkpoints (large model artifacts)
checkpoints/

# Benchmark data (large)
benchmarks/locomo/locomo10.json

# Audit reports (session artifacts)
B12_audit_*.md

# Claude Code local state
.claude/

# Generated B12 review and planning PDFs (internal documents, not for public repo)
docs/B12_Inceleme_Raporu.pdf
docs/B12_Gelistirme_Plani.pdf
docs/B12_*.pdf

# Nested clones / sibling repos that may sit inside this working tree
# (e.g., stray full clones of dorukardahan/B12 itself, or local fork
# checkouts named like the parent dir) — prevents accidental nested commits
B12/
B12-sanitized/
B12-backup-pre-filter/

# Python build artifacts (editable install)
*.egg-info/
.superpowers/
