#!/bin/bash
# B12 ↔ Cline PreCompact hook.
#
# Cline's PreCompact wire payload (per cline#7513, merged 2025-12-09) is:
#   {"preCompact": {"contextRawPath": "<ephemeral path>"}}
#
# The file at .preCompact.contextRawPath is ephemeral — Cline deletes it
# after the hook returns. So the only safe pattern is: copy it to B12
# staging BEFORE we echo our response. memory-precompact.sh then picks
# it up on the next cron / session-start sweep.
#
# Earlier passive-placeholder logic (PR #47) is replaced; see
# the release-plan notes Phase 2 PR6.

set -o pipefail 2>/dev/null || true

B12_DATA_DIR="${B12_DATA_DIR:-$HOME/.B12}"
STAGE_DIR="$B12_DATA_DIR/memory-staging"
mkdir -p "$STAGE_DIR" 2>/dev/null || true

INPUT=$(cat)

CTX_PATH=$(printf '%s' "$INPUT" | jq -r '
  .preCompact.contextRawPath
  // .pre_compact.context_raw_path
  // .preCompact.contextRaw?.path
  // empty
' 2>/dev/null)

if [ -n "$CTX_PATH" ] && [ -r "$CTX_PATH" ]; then
  TS=$(date -u +"%Y-%m-%dT%H-%M-%SZ")
  DEST="$STAGE_DIR/cline-precompact-$TS.json"
  cp "$CTX_PATH" "$DEST" 2>/dev/null || true
fi

# Never block compaction — fail-open even if the copy raised.
echo '{"cancel": false}'
