{
  "_comment": "Merge these into your Claude Code settings.json (e.g. ~/.claude/settings.json)",
  "env": {
    "_comment_env": "B12_WORK_PATTERN: work dir pattern. B12_DATA_DIR: data path (default ~/.B12). B12_HOOK_DIR: hook code path (default ~/.B12/hooks, rarely needed).",
    "B12_WORK_PATTERN": "",
    "B12_DATA_DIR": "",
    "B12_HOOK_DIR": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-session-start.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-precompact.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-session-end.sh",
            "timeout": 35
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-turn-end.sh",
            "timeout": 9
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-tool-failure.sh",
            "timeout": 8
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-instructions-loaded.sh",
            "timeout": 8
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "CLAUDE.md|CLAUDE.local.md|MEMORY.md",
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-file-changed.sh",
            "timeout": 9
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-retrieval.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-prompt-expansion.sh",
            "timeout": 8
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-subagent-stop.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__B12__memory_store",
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-tag-enforce.sh",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-proactive-surface.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__B12__memory_store|mcp__B12__memory_search|mcp__B12__memory_quality|mcp__B12__memory_update",
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-feedback.sh",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-working-context.sh",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-proactive-surface.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.B12/hooks/memory-checkpoint.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
