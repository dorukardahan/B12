{
  "_comment": "Add this to your ~/.claude.json under the top-level mcpServers key",
  "_note": "Replace /path/to/memory with the output of 'which memory'",
  "memory": {
    "command": "/path/to/memory",
    "args": ["server"],
    "env": {
      "MCP_QUALITY_BOOST_ENABLED": "true",
      "MCP_QUALITY_BOOST_WEIGHT": "0.3",
      "MCP_CONSOLIDATION_ENABLED": "true",
      "MCP_DECAY_ENABLED": "true",
      "MCP_RETENTION_CRITICAL": "365",
      "MCP_RETENTION_STANDARD": "60",
      "MCP_RETENTION_TEMPORARY": "14",
      "MCP_FORGETTING_ENABLED": "true",
      "MCP_FORGETTING_ACCESS_THRESHOLD": "90",
      "MCP_FORGETTING_RELEVANCE_THRESHOLD": "0.1",
      "MCP_CLUSTERING_ENABLED": "true",
      "MCP_ASSOCIATIONS_ENABLED": "true"
    }
  }
}
